# Copy to /etc/systemd/system/holdfast.service, adjust paths, then:
#   systemctl daemon-reload && systemctl enable --now holdfast
[Unit]
Description=HOLDFAST game server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/holdfast
Environment=NODE_ENV=production
Environment=PORT=8080
ExecStart=/usr/bin/env npx tsx server/src/index.ts
Restart=always
RestartSec=2
User=holdfast

[Install]
WantedBy=multi-user.target
